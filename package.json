{
  "name": "testing-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": "10.x"
  },
  "scripts": {
    "dev:api": "npm run dev -w @app/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tests.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run lint:workflows && npm run format:check && npm run typecheck && npm test && npm run build",
    "lint": "eslint . --max-warnings 0",
    "lint:workflows": "bash scripts/lint-workflows.sh",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migration:generate": "npm run migration:generate -w @app/api --",
    "migration:run": "npm run migration:run -w @app/api",
    "migration:revert": "npm run migration:revert -w @app/api",
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w @app/api\" \"npm run dev -w @app/web\"",
    "dev:web": "npm run dev -w @app/web",
    "smoke": "node scripts/smoke.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
