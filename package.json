{
  "name": "testing-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": "10.x"
  },
  "scripts": {
    "dev:api": "npm run dev -w @app/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tests.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migration:generate": "npm run migration:generate -w @app/api --",
    "migration:run": "npm run migration:run -w @app/api",
    "migration:revert": "npm run migration:revert -w @app/api"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
