{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "experimentalDecorators": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "apps/*/src",
    "apps/*/tests",
    "apps/*/vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
