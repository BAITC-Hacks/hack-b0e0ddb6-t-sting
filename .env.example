# PostgreSQL credentials for local development. Set a local password in .env.
POSTGRES_USER=app
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=app
# Database host and published port for the local API.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional PEM CA certificate: enables verified TLS for the API and migrations.
# On DigitalOcean bind this to ${db.CA_CERT}; leave empty for local PostgreSQL.
POSTGRES_CA_CERT=
# API listening port.
API_PORT=3000
# Web server port and server-side API proxy target.
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:3000
# Optional server-only OpenAI key from platform.openai.com. Empty enables offline analyst and council.
OPENAI_API_KEY=
# OpenAI model for the analyst and council chair; empty defaults to gpt-4.1-mini.
AI_MODEL=gpt-4.1-mini
# Total analyst deadline in milliseconds before switching to offline explanations.
AI_TIMEOUT_MS=25000
# Optional faster OpenAI model for council members; empty uses AI_MODEL.
AI_COUNCIL_MODEL=
# Per-member deadline in milliseconds (at most 12000); failure uses an isolated offline speech.
AI_COUNCIL_TIMEOUT_MS=12000
